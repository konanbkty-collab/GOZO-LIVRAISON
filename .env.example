# ------------------------------------------------------------------
# GOZO LIVRAISON — variables d'environnement
# Copiez ce fichier en `.env` pour un usage local, ou saisissez ces
# variables dans l'interface de votre hébergeur (Vercel, Railway…).
# Détails et explications : GUIDE_DEPLOIEMENT.md
# ------------------------------------------------------------------

# [OBLIGATOIRE] Adresse de connexion PostgreSQL.
# En production, utilisez l'URL fournie par Neon / Supabase (avec sslmode=require).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# [OBLIGATOIRE EN PRODUCTION] Numéro(s) autorisé(s) à ouvrir le panneau d'administration.
# Plusieurs numéros possibles, séparés par des virgules (gérant, responsable…).
GOZO_ADMIN_PHONES=0707070707

# [OBLIGATOIRE EN PRODUCTION] Passerelle d'envoi des SMS (codes de connexion OTP).
# L'application envoie une requête POST JSON {"to": "+225…", "message": "…"}
# avec l'en-tête "Authorization: Bearer <SMS_GATEWAY_KEY>".
# SMS_GATEWAY_URL=https://api.votre-fournisseur-sms.com/send
# SMS_GATEWAY_KEY=votre_cle_secrete

# [DÉMO UNIQUEMENT] "true" affiche les codes OTP à l'écran, crée des livreurs
# fictifs et montre les numéros de test sur les écrans de connexion.
# Ne jamais mettre "true" sur un site accessible au public.
NEXT_PUBLIC_GOZO_DEMO=true
